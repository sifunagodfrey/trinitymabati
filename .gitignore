# -------------------
# Environment and credentials
# -------------------
/.env
/.env.*
!/.env.example
/auth.json
/storage/*.key

# -------------------
# Dependencies
# -------------------
/vendor/
/node_modules/

# -------------------
# Generated frontend assets
# -------------------
/public/build/
/public/hot
/public/storage

# -------------------
# Laravel bootstrap cache
# Keep directory placeholder
# -------------------
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# -------------------
# Laravel runtime files and uploads
# Keep directories and placeholders
# -------------------
/storage/**
!/storage/**/
!/storage/**/.gitignore

# -------------------
# PHP and testing tools
# -------------------
/.phpactor.json
/.phpunit.result.cache
/.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan.cache/
/.phpunit-watcher.yml

# -------------------
# IDE and editor files
# -------------------
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
*.swp
*.swo
*~

# -------------------
# Logs
# -------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------
# Operating system files
# -------------------
.DS_Store
Thumbs.db
Desktop.ini